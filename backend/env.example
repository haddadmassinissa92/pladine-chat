# Copie ce fichier en .env et remplis chaque valeur avant de démarrer le serveur.
# Ne commite JAMAIS le vrai fichier .env (il doit rester dans .gitignore).

# URL de connexion à ta base de données MongoDB (Atlas ou locale)
MONGO_URI=mongodb+srv://<utilisateur>:<mot_de_passe>@<cluster>.mongodb.net

# Clé secrète utilisée pour signer les tokens JWT de session.
# Utilise une chaîne longue et aléatoire (ex: générée avec `openssl rand -base64 32`)
JWT_SECRET=une_chaine_secrete_longue_et_aleatoire

# URL du frontend déployé (utilisée pour la config CORS et les cookies cross-domain)
CLIENT_URL=http://localhost:3000

# Port sur lequel le serveur backend écoute
PORT=5001

# Identifiants Cloudinary (upload des avatars, images et messages vocaux)
CLOUDINARY_CLOUD_NAME=ton_cloud_name
CLOUDINARY_API_KEY=ta_cle_api
CLOUDINARY_API_SECRET=ton_secret_api

# Environnement d'exécution : "development" en local, "production" en ligne
NODE_ENV=development
